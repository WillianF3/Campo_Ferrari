Options -Indexes
RewriteEngine On
RewriteRule ^private-gallery(?:/|$) - [F,L,NC]
<FilesMatch "^(?:bootstrap|schema|closed-lists|notifications|push|gallery|admin-accounts-seed|config(?:\.[^/]*)?)\.php$">
Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^(?:bootstrap|schema|closed-lists|notifications|push|gallery|admin-accounts-seed|config(?:\.[^/]*)?)\.php$ - [F,L,NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]
